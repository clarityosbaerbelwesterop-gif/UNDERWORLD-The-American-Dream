# Godot
GodotProject/.godot/
GodotProject/.import/
*.translation
export_presets.cfg.local
# Builds and logs
Builds/*
!Builds/.gitkeep
Tests/logs/
*.log
# Blender backups / autosave
*.blend1
*.blend2
*.blend@
__pycache__/
*.pyc
# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
# Secrets never in git
.env
*.pem
*.key
# External asset source caches (CC0 packs, raw texture downloads, high-poly bake temps)
.cache/
Blender/Cache/
# Godot auto-extracted embedded GLB texture duplicates (textures stay embedded inside .glb)
Assets/**/*_T_*.jpg
Assets/**/*_T_*.png
Assets/**/*.import
!Assets/Test/PT_PipelineTest_Crate.glb.import


# Plan-view captures are regenerable from the scene (no GPU needed) and git-lfs is not
# installable on the sandbox box, so the PNG is not committed:
#   $GODOT --headless --path GodotProject --script res://Tests/tools/capture_level_plan.gd
Docs/Reports/plan_calloway_ave.png

# Procedural audio library (T-AUD-01). Regenerable and deterministic:
#   Tools/uwp build-audio        (~45 s, numpy + scipy + soundfile; CI renders it before the gate)
# Not committed because git-lfs is not installable on the sandbox box and *.ogg is LFS-tracked
# (.gitattributes). The runtime table GodotProject/Data/Content/audio.json IS committed.
# To commit the binaries from an LFS-capable box: delete these two lines, `Tools/uwp build-audio`,
# `git add Assets/Audio` (sha256 per file in Assets/Audio/audio.manifest.json).
Assets/Audio/**/*.ogg
Assets/Audio/audio.manifest.json
