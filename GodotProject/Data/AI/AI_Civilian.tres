[gd_resource type="Resource" script_class="AIProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/ai/ai_profile.gd" id="1_prof"]

; AI_Civilian - ambient pedestrian (T-AI-02 baseline, delivered with T-AI-01).
; [DOC]     wander along route nodes, idle at points, flee on gunfire within 25 m (TASK_BOARD T-AI-02).
; [DEFAULT] other numbers = Bot 3 starting values.
[resource]
script = ExtResource("1_prof")
id = "AI_Civilian"
max_health = 60.0
initial_state = "idle"
transitions = {
"flee": {
"damaged": "flee",
"heard_gunshot": "flee",
"timeout": "idle"
},
"idle": {
"damaged": "flee",
"heard_gunshot": "flee"
}
}
state_timeouts = {
"flee": 8.0
}
walk_speed = 1.3
flee_speed = 5.0
route_idle_time = 2.0
hearing_range = 25.0
use_cover = false
