# UNDERWORLD - runtime audio (T-AUD-01). Autoload "Audio" (project.godot).
#
# Data-driven: every sound is an *event* in res://Data/Content/audio.json (generated by
# `Tools/uwp build-audio` together with the Ogg files under Assets/Audio). The table also holds
# the *bindings* (weapon id -> fire/tail/reload events, FX scene -> sound, surface groups ->
# footstep set, vehicle id -> engine set, mission signals -> UI/music).
#
# Non-invasive: gameplay scripts are not edited. The director watches SceneTree.node_added and
# connects to the signals the gameplay classes already emit (Weapon, PlayerWeaponController,
# NPCController, DamageReceiver, PlayerController, Vehicle, MissionManager, CarriedItem, FXEffect).
#
# Mixing: buses Music/SFX/Weapons/Vehicles/Foley/Ambience/UI/VO (created at runtime if the
# project has no bus layout), music is side-chain ducked by the Weapons bus, hard limiter on
# Master. Voices come from fixed pools (3D 40, 2D 16) with oldest-voice stealing; 3D one-shots
# beyond an event's max_distance from the listener are culled. Gunshots = close layer + a
# separate long-range tail event, so distant fights sound like distant fights.
#
# Missing Ogg files (fresh clone before `Tools/uwp build-audio`) only warn once - never error.
# Headless (tests, CI, server): no AudioServer playback is ever started. Nobody can hear it, and a
# playback still in the AudioServer list when the process quits keeps its stream alive past
# ResourceCache::clear ("N resources still in use at exit" = a red gameplay test). Everything else
# (event resolution, stream loading, history, stats, voice allocation by duration) runs as usual.
# Negative control: UW_AUDIO_SABOTAGE=1 (debug builds) resolves every event to UI_Click.
class_name AudioDirector
extends Node

const TABLE_PATH := "res://Data/Content/audio.json"
const POOL_3D := 40
const POOL_2D := 16
const HISTORY := 128
const COMBAT_STATES := ["engage", "take_cover", "in_cover"]
const DEFAULT_LAYER_RPM := {"Idle": 800.0, "Low": 2500.0, "High": 5200.0}

static var instance: AudioDirector

var events: Dictionary = {}
var bindings: Dictionary = {}
var enabled := true
## False under --headless (see the header): voices are allocated and timed, but never play().
var output := true
## Ring buffer of the last played event ids (debug overlay / tests).
var history: PackedStringArray = []
var stats := {"played": 0, "culled": 0, "stolen": 0, "missing": 0}
var music_state := ""
var ambience_key := ""

var _sabotage := false
var _streams: Dictionary = {}
var _warned: Dictionary = {}
var _last_variant: Dictionary = {}
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pool2d: Array[AudioStreamPlayer] = []
var _rng := RandomNumberGenerator.new()
var _music: Array[AudioStreamPlayer] = []
var _music_active := 0
var _music_fade := 0.0
var _combat_left := 0.0
var _amb: AudioStreamPlayer
var _amb_os_left := 0.0
var _chars: Array[Dictionary] = []
var _vehicles: Array[Dictionary] = []
var _reload_gen: Dictionary = {}

# --- lifecycle -----------------------------------------------------------------

func _enter_tree() -> void:
	if instance != null and instance != self and is_instance_valid(instance):
		queue_free()
		return
	instance = self

func _exit_tree() -> void:
	if instance == self:
		instance = null
	for c in get_children():
		if c is AudioStreamPlayer or c is AudioStreamPlayer3D:
			c.call(&"stop")

func _ready() -> void:
	if instance != self:
		return
	process_mode = Node.PROCESS_MODE_ALWAYS
	output = DisplayServer.get_name() != "headless" and OS.get_environment("UW_AUDIO_OUTPUT") != "0"
	_sabotage = OS.is_debug_build() and OS.get_environment("UW_AUDIO_SABOTAGE") == "1"
	if Weapon.replay_seed() != 0:
		_rng.seed = Weapon.replay_seed() + 77
	else:
		_rng.randomize()
	load_table()
	ensure_buses()
	_build_pools()
	get_tree().node_added.connect(_on_node_added)
	_scan(get_tree().root)

func load_table(path := TABLE_PATH) -> bool:
	if not FileAccess.file_exists(path):
		push_warning("AudioDirector: %s missing - run Tools/uwp build-audio" % path)
		return false
	var d = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not (d is Dictionary):
		push_warning("AudioDirector: %s is not valid JSON" % path)
		return false
	events = (d as Dictionary).get("events", {})
	bindings = (d as Dictionary).get("bindings", {})
	return true

## Creates the mixer buses the table names (no-op for buses the project layout already has).
func ensure_buses() -> void:
	for b in ["Music", "SFX", "Weapons", "Vehicles", "Foley", "Ambience", "UI", "VO"]:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, b)
			AudioServer.set_bus_send(i, &"Master")
	var weapons := AudioServer.get_bus_index("Weapons")
	if AudioServer.get_bus_effect_count(weapons) == 0:
		var comp := AudioEffectCompressor.new()
		comp.threshold = -10.0
		comp.ratio = 4.0
		comp.attack_us = 200.0
		comp.release_ms = 120.0
		AudioServer.add_bus_effect(weapons, comp)
	var music := AudioServer.get_bus_index("Music")
	if AudioServer.get_bus_effect_count(music) == 0:
		var duck := AudioEffectCompressor.new()  # gunfire ducks the score
		duck.threshold = -24.0
		duck.ratio = 6.0
		duck.release_ms = 450.0
		duck.sidechain = &"Weapons"
		AudioServer.add_bus_effect(music, duck)
	if AudioServer.get_bus_effect_count(0) == 0:
		var lim := AudioEffectHardLimiter.new()
		lim.ceiling_db = -0.5
		AudioServer.add_bus_effect(0, lim)

func _build_pools() -> void:
	for i in POOL_3D:
		var p := AudioStreamPlayer3D.new()
		p.name = "V3D_%02d" % i
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p)
		_pool3d.append(p)
	for i in POOL_2D:
		var p := AudioStreamPlayer.new()
		p.name = "V2D_%02d" % i
		add_child(p)
		_pool2d.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.name = "Music%d" % i
		m.bus = &"Music"
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)
	_amb = AudioStreamPlayer.new()
	_amb.name = "AmbienceBed"
	_amb.bus = &"Ambience"
	add_child(_amb)

# --- event playback --------------------------------------------------------------

func has_event(id: String) -> bool:
	return events.has(id)

func _resolve(id: String) -> String:
	return "UI_Click" if _sabotage and events.has("UI_Click") else id

## Stream for one variation of an event (random, never the same twice in a row). Null if the
## event or its files are missing.
func pick_stream(id: String) -> AudioStream:
	var ev: Dictionary = events.get(id, {})
	var files: Array = ev.get("files", [])
	if files.is_empty():
		_warn_once(id, "AudioDirector: unknown event %s" % id)
		return null
	var idx := 0
	var last := int(_last_variant.get(id, -1))
	if files.size() > 1 and last < 0:
		idx = _rng.randi_range(0, files.size() - 1)
	elif files.size() > 1:
		idx = _rng.randi_range(0, files.size() - 2)
		if idx >= last:
			idx += 1
	_last_variant[id] = idx
	return load_stream(String(files[idx]), bool(ev.get("loop", false)))

func load_stream(path: String, loop := false) -> AudioStream:
	var key := path + ("#loop" if loop else "")
	if _streams.has(key):
		return _streams[key]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	elif FileAccess.file_exists(path):
		s = AudioStreamOggVorbis.load_from_file(ProjectSettings.globalize_path(path))
	if s == null:
		stats["missing"] = int(stats["missing"]) + 1
		_warn_once(path, "AudioDirector: %s not found - run Tools/uwp build-audio" % path)
		return null
	if loop:
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
		elif s is AudioStreamWAV:
			(s as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
	_streams[key] = s
	return s

func _record(id: String) -> void:
	stats["played"] = int(stats["played"]) + 1
	history.append(id)
	if history.size() > HISTORY:
		history.remove_at(0)

func played(id: String) -> bool:
	return history.has(id)

func clear_history() -> void:
	history.clear()

func _listener_pos() -> Variant:
	var vp := get_viewport()
	if vp == null:
		return null
	var cam := vp.get_camera_3d()
	return cam.global_position if cam != null else null

## Positional one-shot. Returns the voice (or null if culled / missing).
func play_at(id: String, pos: Vector3, volume_db := 0.0, pitch := 1.0) -> AudioStreamPlayer3D:
	if not enabled:
		return null
	id = _resolve(id)
	var ev: Dictionary = events.get(id, {})
	if ev.is_empty():
		_warn_once(id, "AudioDirector: unknown event %s" % id)
		return null
	var lp = _listener_pos()
	if lp != null and pos.distance_to(lp) > float(ev.get("max_distance", 100.0)):
		stats["culled"] = int(stats["culled"]) + 1
		_record(id)
		return null
	var s := pick_stream(id)
	_record(id)
	if s == null:
		return null
	var p := _voice3d()
	p.stream = s
	p.global_position = pos
	_setup3d(p, ev, volume_db, pitch)
	_start(p, s, p.pitch_scale)
	return p

## 2D one-shot (UI, stingers, ambience one-shots).
func play_2d(id: String, volume_db := 0.0, pitch := 1.0) -> AudioStreamPlayer:
	if not enabled:
		return null
	id = _resolve(id)
	var ev: Dictionary = events.get(id, {})
	if ev.is_empty():
		_warn_once(id, "AudioDirector: unknown event %s" % id)
		return null
	var s := pick_stream(id)
	_record(id)
	if s == null:
		return null
	var p := _voice2d()
	p.stream = s
	p.bus = StringName(ev.get("bus", "SFX"))
	p.volume_db = float(ev.get("volume_db", 0.0)) + volume_db
	p.pitch_scale = pitch * (1.0 + _rng.randf_range(-1.0, 1.0) * float(ev.get("pitch_jitter", 0.0)))
	_start(p, s, p.pitch_scale)
	return p

## A looping (or one-shot) 3D emitter owned by `node` - moves with it and dies with it.
func attach(id: String, node: Node3D, volume_db := 0.0, autoplay := true) -> AudioStreamPlayer3D:
	id = _resolve(id)
	var ev: Dictionary = events.get(id, {})
	if ev.is_empty() or node == null:
		return null
	var p := AudioStreamPlayer3D.new()
	p.name = "UW_Audio_" + id
	p.stream = pick_stream(id)
	_setup3d(p, ev, volume_db, 1.0)
	node.add_child(p)
	if autoplay and p.stream != null and enabled:
		_play(p)
	_record(id)
	return p

func _setup3d(p: AudioStreamPlayer3D, ev: Dictionary, volume_db: float, pitch: float) -> void:
	p.bus = StringName(ev.get("bus", "SFX"))
	p.unit_size = float(ev.get("unit_size", 8.0))
	p.max_distance = float(ev.get("max_distance", 100.0))
	p.volume_db = float(ev.get("volume_db", 0.0)) + volume_db
	p.pitch_scale = pitch * (1.0 + _rng.randf_range(-1.0, 1.0) * float(ev.get("pitch_jitter", 0.0)))
	p.attenuation_filter_cutoff_hz = 6000.0
	p.attenuation_filter_db = -18.0

## play() unless headless (header). Works for AudioStreamPlayer and AudioStreamPlayer3D.
func _play(p: Node) -> void:
	if output:
		p.call(&"play")

## Starts a pooled one-shot voice and books it for the stream's duration, so voice allocation and
## stealing behave the same with and without audio output.
func _start(p: Node, s: AudioStream, pitch: float) -> void:
	var now := Time.get_ticks_msec()
	p.set_meta(&"t", now)
	p.set_meta(&"end", now + int(1000.0 * s.get_length() / maxf(pitch, 0.05)))
	_play(p)

func _busy(p: Node) -> bool:
	return bool(p.get(&"playing")) or Time.get_ticks_msec() < int(p.get_meta(&"end", 0))

func _voice3d() -> AudioStreamPlayer3D:
	var oldest: AudioStreamPlayer3D = _pool3d[0]
	for p in _pool3d:
		if not _busy(p):
			return p
		if int(p.get_meta(&"t", 0)) < int(oldest.get_meta(&"t", 0)):
			oldest = p
	stats["stolen"] = int(stats["stolen"]) + 1
	oldest.stop()
	return oldest

func _voice2d() -> AudioStreamPlayer:
	var oldest: AudioStreamPlayer = _pool2d[0]
	for p in _pool2d:
		if not _busy(p):
			return p
		if int(p.get_meta(&"t", 0)) < int(oldest.get_meta(&"t", 0)):
			oldest = p
	stats["stolen"] = int(stats["stolen"]) + 1
	oldest.stop()
	return oldest

func _later(seconds: float, cb: Callable) -> void:
	get_tree().create_timer(seconds, false).timeout.connect(cb)

## Delayed callback on a node that may be freed meanwhile. Captures only the instance id: a lambda
## that captured the node itself logs "Lambda capture ... was freed" (an ERROR) when it fires late.
func _later_at(seconds: float, node: Node3D, cb: Callable) -> void:
	var nid := node.get_instance_id()
	_later(seconds, func() -> void:
		var n := instance_from_id(nid) as Node3D
		if n != null and n.is_inside_tree():
			cb.call(n))

func _warn_once(key: String, msg: String) -> void:
	if not _warned.has(key):
		_warned[key] = true
		push_warning(msg)

# --- registration ------------------------------------------------------------------

func _scan(n: Node) -> void:
	_on_node_added(n)
	for c in n.get_children():
		_scan(c)

func _on_node_added(n: Node) -> void:
	if n.has_meta(&"uw_audio") or n.get_parent() == self:
		return
	if (n is Weapon or n is FXEffect or n is Vehicle or n is PlayerController or n is NPCController
			or n is PlayerWeaponController or n is DamageReceiver or n is MissionManager or n is CarriedItem):
		n.set_meta(&"uw_audio", true)
		# Deferred: node_added fires while the parent is still setting up its children (no
		# add_child allowed yet) and before spawn() has placed the node.
		_register.call_deferred(n)

func _register(n) -> void:
	if not is_instance_valid(n) or not (n as Node).is_inside_tree():
		return
	if n is Weapon:
		_hook_weapon(n as Weapon)
	elif n is FXEffect:
		_on_fx(n as FXEffect)
	elif n is Vehicle:
		_hook_vehicle(n as Vehicle)
	elif n is PlayerController:
		_hook_player(n as PlayerController)
	elif n is NPCController:
		_hook_npc(n as NPCController)
	elif n is PlayerWeaponController:
		(n as PlayerWeaponController).hitmarker.connect(_on_hitmarker)
	elif n is DamageReceiver:
		(n as DamageReceiver).died.connect(_on_receiver_died.bind(n))
	elif n is MissionManager:
		_hook_mission(n as MissionManager)
	elif n is CarriedItem:
		var item := n as CarriedItem
		item.picked_up.connect(func(_by: Node3D) -> void:
			play_at(String(_char_b().get("pickup", "SFX_FOL_Pickup_Item")), item.global_position))

func _char_b() -> Dictionary:
	return bindings.get("character", {})

# --- weapons -----------------------------------------------------------------------

func weapon_binding(w: Weapon) -> Dictionary:
	var wb: Dictionary = bindings.get("weapons", {})
	var id := String(w.data.id) if w.data != null else ""
	return wb.get(id, wb.get("_default", {}))

func _hook_weapon(w: Weapon) -> void:
	w.fired.connect(_on_weapon_fired.bind(w))
	w.dry_fired.connect(func() -> void: play_at(String(bindings.get("dry_fire", "SFX_WPN_DryFire")), w.global_position))
	w.reload_started.connect(_on_reload_started.bind(w))
	w.reload_cancelled.connect(func() -> void: _reload_gen[w.get_instance_id()] = int(_reload_gen.get(w.get_instance_id(), 0)) + 1)

func _on_weapon_fired(shot: Dictionary, w: Weapon) -> void:
	var b := weapon_binding(w)
	var pos: Vector3 = shot.get("origin", w.global_position)
	if b.has("fire"):
		play_at(String(b["fire"]), pos)
	if b.has("tail"):
		play_at(String(b["tail"]), pos)
	if bool(b.get("casing", false)):
		var cpos := pos + Vector3(0.0, -1.2, 0.0)
		_later(_rng.randf_range(0.35, 0.6), func() -> void: play_at(String(bindings.get("casing", "SFX_WPN_ShellCasing")), cpos))
	if b.has("pump_after_shot") and w.ammo > 0:
		var pump := String(b["pump_after_shot"])
		_later_at(0.42, w, func(n: Node3D) -> void: play_at(pump, n.global_position))
	_combat_ping()
	if _npc_owner(w) != null:
		_flyby(shot)

func _on_reload_started(duration: float, w: Weapon) -> void:
	var b := weapon_binding(w)
	var key := w.get_instance_id()
	var gen := int(_reload_gen.get(key, 0)) + 1
	_reload_gen[key] = gen
	for step in b.get("reload", []):
		var at := float(step[0]) * duration
		var id := String(step[1])
		_later_at(maxf(at, 0.01), w, func(n: Node3D) -> void:
			if int(_reload_gen.get(key, 0)) == gen:
				play_at(id, n.global_position))

func _flyby(shot: Dictionary) -> void:
	var lp = _listener_pos()
	if lp == null or not shot.has("origin") or not shot.has("end"):
		return
	var listener: Vector3 = lp
	var a: Vector3 = shot["origin"]
	var e: Vector3 = shot["end"]
	var closest := Geometry3D.get_closest_point_to_segment(listener, a, e)
	var d := closest.distance_to(listener)
	if d < 3.0 and closest.distance_to(a) > 4.0:
		play_at("SFX_BUL_Flyby", closest)

func _npc_owner(n: Node) -> NPCController:
	var p := n.get_parent()
	while p != null:
		if p is NPCController:
			return p as NPCController
		p = p.get_parent()
	return null

func _on_hitmarker(info: DamageInfo) -> void:
	var ui: Dictionary = bindings.get("ui", {})
	play_2d(String(ui.get("killmarker" if info.killed else "hitmarker", "UI_Hitmarker")))

func _on_receiver_died(_info: DamageInfo, r: DamageReceiver) -> void:
	var body := r.get_parent() as Node3D
	if body == null or body is Vehicle:
		return
	_later_at(0.45, body, func(n: Node3D) -> void:
		play_at(String(_char_b().get("body_fall", "SFX_FOL_BodyFall")), n.global_position))

# --- FX ----------------------------------------------------------------------------

func _on_fx(fx: FXEffect) -> void:
	var id := fx.scene_file_path.get_file().get_basename()
	if id.is_empty():
		id = String(fx.name)
	var map: Dictionary = bindings.get("fx", {})
	if not map.has(id):
		return
	var ev_id := String(map[id])
	var f := fx as FXEffect
	if bool((events.get(ev_id, {}) as Dictionary).get("loop", false)) or not f.one_shot:
		attach(ev_id, f)
	else:
		play_at(ev_id, f.global_position)
	if (id == "FX_Impact_Concrete" or id == "FX_Impact_Metal") and _rng.randf() < float(bindings.get("ricochet_chance", 0.0)):
		play_at("SFX_IMP_Ricochet", f.global_position)

# --- characters (footsteps, jump, land) --------------------------------------------

func _hook_player(p: PlayerController) -> void:
	_chars.append({"node": p, "dist": 0.0})
	p.jumped.connect(func() -> void: play_at(String(_char_b().get("jump", "SFX_FOL_Jump")), p.global_position))
	p.landed.connect(func(speed: float) -> void:
		var heavy := speed >= float(_char_b().get("land_heavy_mps", 7.0))
		play_at(String(_char_b().get("land_heavy" if heavy else "land", "SFX_FOL_Land")), p.global_position))
	if ambience_key.is_empty():
		start_ambience.call_deferred("")

func _hook_npc(n: NPCController) -> void:
	_chars.append({"node": n, "dist": 0.0})
	n.state_changed.connect(func(_from: String, to: String, _ev: String) -> void:
		if to in COMBAT_STATES:
			_combat_ping())

## Footstep event for a character standing on `floor` moving at `speed` m/s.
func footstep_event(floor_collider: Object, speed: float) -> String:
	var fb: Dictionary = bindings.get("footsteps", {})
	var surface := String(fb.get("default_surface", "Concrete"))
	if floor_collider is Node:
		var groups: Dictionary = fb.get("groups", {})
		for g in groups:
			if (floor_collider as Node).is_in_group(StringName(g)):
				surface = String(groups[g])
				break
	var gait := "Run" if speed >= float(fb.get("run_speed_mps", 2.6)) else "Walk"
	return "SFX_FS_%s_%s" % [surface, gait]

func _floor_collider(c: CharacterBody3D) -> Object:
	for i in c.get_slide_collision_count():
		var col := c.get_slide_collision(i)
		if col.get_normal().y > 0.6:
			return col.get_collider()
	return null

func _update_chars(delta: float) -> void:
	var fb: Dictionary = bindings.get("footsteps", {})
	var stride_walk := float(fb.get("stride_walk_m", 0.72))
	var stride_run := float(fb.get("stride_run_m", 1.15))
	var run_speed := float(fb.get("run_speed_mps", 2.6))
	for i in range(_chars.size() - 1, -1, -1):
		var c: Dictionary = _chars[i]
		var body = c["node"]
		if not is_instance_valid(body):
			_chars.remove_at(i)
			continue
		var cb := body as CharacterBody3D
		if not cb.is_inside_tree() or not cb.is_on_floor() or not cb.is_visible_in_tree():
			continue
		if cb is PlayerController and (cb as PlayerController).vehicle != null:
			continue
		var v := Vector2(cb.velocity.x, cb.velocity.z).length()
		if v < 0.4:
			c["dist"] = minf(float(c["dist"]), stride_walk * 0.6)
			continue
		var stride := stride_run if v >= run_speed else stride_walk
		c["dist"] = float(c["dist"]) + v * delta
		if float(c["dist"]) >= stride:
			c["dist"] = float(c["dist"]) - stride
			play_at(footstep_event(_floor_collider(cb), v), cb.global_position, -2.0 if cb is NPCController else 0.0)

# --- vehicles ----------------------------------------------------------------------

func engine_set_for(v: Vehicle) -> String:
	var vb: Dictionary = bindings.get("vehicles", {})
	var sets: Dictionary = vb.get("engine_sets", {})
	var id := String(v.data.id) if v.data != null else ""
	return String(sets.get(id, sets.get("_default", "Sedan")))

func _hook_vehicle(v: Vehicle) -> void:
	var kind := engine_set_for(v)
	var rec := {"node": v, "kind": kind, "on": 0.0, "layers": {}, "rpm": {}}
	var rpms: Dictionary = ((bindings.get("vehicles", {}) as Dictionary).get("layer_rpm", {}) as Dictionary).get(kind, {})
	for layer in ["Idle", "Low", "High"]:
		var p := attach("SFX_VEH_%s_Engine_%s" % [kind, layer], v, -80.0, false)
		if p != null:
			p.name = "UW_Engine_" + layer
			(rec["layers"] as Dictionary)[layer] = p
			(rec["rpm"] as Dictionary)[layer] = float(rpms.get(layer, DEFAULT_LAYER_RPM[layer]))
	rec["skid"] = attach("SFX_VEH_Tire_Skid", v, -80.0, false)
	rec["roll"] = attach("SFX_VEH_Road_Roll", v, -80.0, false)
	_vehicles.append(rec)
	var vb2: Dictionary = bindings.get("vehicles", {})
	v.crashed.connect(func(speed: float, _dmg: float) -> void:
		if speed >= float(vb2.get("crash_heavy_mps", 9.0)):
			play_at("SFX_VEH_Crash_Heavy", v.global_position)
		elif speed >= float(vb2.get("crash_light_mps", 3.0)):
			play_at("SFX_VEH_Crash_Light", v.global_position))
	v.door_changed.connect(func(_door: StringName, open: bool) -> void:
		play_at("SFX_VEH_Door_Open" if open else "SFX_VEH_Door_Close", v.global_position))
	var start_id := "SFX_VEH_%s_Start" % kind
	var stop_id := "SFX_VEH_%s_Stop" % kind
	v.entered.connect(func(_d: Node3D) -> void:
		if has_event(start_id):
			play_at(start_id, v.global_position))
	v.exited.connect(func(_d: Node3D) -> void:
		if has_event(stop_id):
			play_at(stop_id, v.global_position))

func engine_running(v: Vehicle) -> bool:
	return not v.is_wrecked() and (v.driver != null or v.control_override)

## Per-layer pitch + gain for the RPM crossfade (exposed for tests).
func engine_mix(rec: Dictionary) -> Dictionary:
	var v: Vehicle = rec["node"]
	var rpm_tab: Dictionary = rec["rpm"]
	var f := 0.0
	if v.data != null and v.data.pitch_max > v.data.pitch_idle:
		f = clampf((v.engine_pitch - v.data.pitch_idle) / (v.data.pitch_max - v.data.pitch_idle), 0.0, 1.0)
	var r_idle := float(rpm_tab.get("Idle", 800.0))
	var r_low := float(rpm_tab.get("Low", 2500.0))
	var r_high := float(rpm_tab.get("High", 5200.0))
	var rpm := lerpf(r_idle, r_high * 1.05, f)
	var ld := clampf(absf(v.throttle), 0.0, 1.0)
	var w_idle := clampf(1.0 - (rpm - r_idle) / (r_low - r_idle), 0.0, 1.0)
	var w_high := clampf((rpm - r_low) / (r_high - r_low), 0.0, 1.0)
	var w_low := clampf(1.0 - w_idle - w_high, 0.0, 1.0)
	return {
		"rpm": rpm, "load": ld,
		"Idle": [clampf(rpm / r_idle, 0.5, 2.5), w_idle],
		"Low": [clampf(rpm / r_low, 0.5, 2.5), w_low * (0.7 + 0.3 * ld)],
		"High": [clampf(rpm / r_high, 0.5, 2.5), w_high * (0.75 + 0.25 * ld)],
	}

func _update_vehicles(delta: float) -> void:
	for i in range(_vehicles.size() - 1, -1, -1):
		var rec: Dictionary = _vehicles[i]
		var v = rec["node"]
		if not is_instance_valid(v):
			_vehicles.remove_at(i)
			continue
		var veh := v as Vehicle
		var target := 1.0 if engine_running(veh) else 0.0
		rec["on"] = move_toward(float(rec["on"]), target, delta * 1.5)
		var on := float(rec["on"])
		var mix := engine_mix(rec)
		for layer in (rec["layers"] as Dictionary):
			var p: AudioStreamPlayer3D = rec["layers"][layer]
			var pw: Array = mix[layer]
			var gain := float(pw[1]) * on
			p.pitch_scale = float(pw[0])
			p.volume_db = linear_to_db(maxf(gain, 0.0001))
			if gain > 0.001 and not p.playing and p.stream != null and enabled:
				_play(p)
			elif gain <= 0.001 and p.playing:
				p.stop()
		var speed := veh.linear_velocity.length()
		var lateral := absf(veh.linear_velocity.dot(veh.global_basis.x))
		var skid := 0.0
		if speed > 3.0:
			skid = clampf((lateral - 2.0) / 5.0, 0.0, 1.0)
			if veh.handbrake_input > 0.5:
				skid = maxf(skid, clampf(speed / 12.0, 0.0, 1.0))
		_drive_loop(rec.get("skid"), skid, 0.9 + 0.2 * clampf(speed / 30.0, 0.0, 1.0))
		_drive_loop(rec.get("roll"), clampf(speed / 25.0, 0.0, 1.0), 0.7 + 0.6 * clampf(speed / 35.0, 0.0, 1.0))

func _drive_loop(p, gain: float, pitch: float) -> void:
	if p == null or not is_instance_valid(p):
		return
	var pl := p as AudioStreamPlayer3D
	pl.volume_db = linear_to_db(maxf(gain, 0.0001))
	pl.pitch_scale = pitch
	if gain > 0.01 and not pl.playing and pl.stream != null and enabled:
		_play(pl)
	elif gain <= 0.01 and pl.playing:
		pl.stop()

## Police light bar etc.: toggles a looping siren on the vehicle.
func set_siren(v: Vehicle, on: bool, mode := "Wail") -> void:
	var existing := v.get_node_or_null("UW_Siren") as AudioStreamPlayer3D
	if existing != null:
		existing.queue_free()
	if on:
		var p := attach("SFX_VEH_Siren_" + mode, v)
		if p != null:
			p.name = "UW_Siren"

# --- mission / UI / music ------------------------------------------------------------

func _hook_mission(m: MissionManager) -> void:
	var ui: Dictionary = bindings.get("ui", {})
	var mus: Dictionary = bindings.get("music", {})
	m.mission_started.connect(func(_md: MissionData) -> void: set_music("explore"))
	m.objective_started.connect(func(_i: int, _o: ObjectiveData) -> void: play_2d(String(ui.get("objective_new", "UI_Objective_New"))))
	m.objective_completed.connect(func(_i: int, _o: ObjectiveData) -> void: play_2d(String(ui.get("objective_complete", "UI_Objective_Complete"))))
	m.checkpoint_saved.connect(func(_i: int) -> void: play_2d(String(ui.get("checkpoint", "UI_Checkpoint"))))
	m.mission_completed.connect(func(_md: MissionData, cash: int) -> void:
		set_music("")
		play_2d(String(mus.get("passed", "MUS_Stinger_MissionPassed")))
		if cash > 0:
			_later(1.2, func() -> void: play_2d(String(ui.get("cash", "UI_Cash")))))
	m.mission_failed.connect(func(_r: String) -> void:
		set_music("")
		play_2d(String(mus.get("failed", "MUS_Stinger_MissionFailed"))))

func _combat_ping() -> void:
	var mus: Dictionary = bindings.get("music", {})
	_combat_left = float(mus.get("combat_hold_s", 9.0))
	if music_state == "explore":
		set_music("combat")

## "" stops the score; otherwise a key of bindings.music ("explore", "combat", "menu").
func set_music(state: String) -> void:
	if state == music_state:
		return
	music_state = state
	var mus: Dictionary = bindings.get("music", {})
	_music_fade = float(mus.get("crossfade_s", 2.5))
	if state.is_empty():
		_music_active = -1
		return
	var id := String(mus.get(state, ""))
	id = _resolve(id)
	var s: AudioStream = null
	if events.has(id):
		s = pick_stream(id)
	_record(id)
	var next := 1 - maxi(_music_active, 0)
	_music_active = next
	if s != null and enabled:
		_music[next].stream = s
		_music[next].volume_db = -40.0
		_play(_music[next])

func _update_music(delta: float) -> void:
	if _combat_left > 0.0:
		_combat_left -= delta
		if _combat_left <= 0.0 and music_state == "combat":
			set_music("explore")
	var rate := 40.0 / maxf(_music_fade, 0.1)
	for i in _music.size():
		var m := _music[i]
		var target := 0.0 if i == _music_active else -60.0
		m.volume_db = move_toward(m.volume_db, target, rate * delta)
		if m.playing and i != _music_active and m.volume_db <= -59.0:
			m.stop()

## Ambience bed by key of bindings.ambience ("LA", "LA_night", "NY", "rain", "interior");
## "" = pick from the current scene name (NY scenes -> NY, else LA).
func start_ambience(key: String) -> void:
	var amb: Dictionary = bindings.get("ambience", {})
	if key.is_empty():
		var scene := get_tree().current_scene
		key = "NY" if scene != null and String(scene.name).contains("NY") else "LA"
	if not amb.has(key):
		return
	ambience_key = key
	var id := _resolve(String(amb[key]))
	_amb.stream = pick_stream(id)
	_record(id)
	var ev: Dictionary = events.get(id, {})
	_amb.volume_db = float(ev.get("volume_db", 0.0))
	if _amb.stream != null and enabled:
		_play(_amb)
	var iv: Array = amb.get("oneshot_interval_s", [9.0, 26.0])
	_amb_os_left = _rng.randf_range(float(iv[0]), float(iv[1]))

func stop_ambience() -> void:
	ambience_key = ""
	_amb.stop()

func _update_ambience(delta: float) -> void:
	if ambience_key.is_empty():
		return
	_amb_os_left -= delta
	if _amb_os_left <= 0.0:
		var amb: Dictionary = bindings.get("ambience", {})
		var shots: Array = amb.get("oneshots", [])
		if not shots.is_empty():
			play_2d(String(shots[_rng.randi_range(0, shots.size() - 1)]), _rng.randf_range(-6.0, 0.0))
		var iv: Array = amb.get("oneshot_interval_s", [9.0, 26.0])
		_amb_os_left = _rng.randf_range(float(iv[0]), float(iv[1]))

func _physics_process(delta: float) -> void:
	_update_chars(delta)
	_update_vehicles(delta)

func _process(delta: float) -> void:
	_update_music(delta)
	_update_ambience(delta)
