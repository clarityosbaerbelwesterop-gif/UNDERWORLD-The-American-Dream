#!/usr/bin/env bash
# Wrapper: run the UNDERWORLD asset pipeline headless in Blender.
#   Tools/uwp export Blender/Source/Props/SM_Foo/SM_Foo.blend [--no-lod] [--no-collision] ...
#   Tools/uwp catalog status|plan|check|build [...]                          # content catalogue, no Blender
#   Tools/uwp review-sheet <asset> [--ref ...] [--renders ...] [--out ...]   # system Python, no Blender
#   Tools/uwp --help | Tools/uwp export --help
# Exit code is the pipeline's (0 PASS, 1 validation, 2 export, 3 verify, 4 usage, 5 internal).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# catalog is plain Python (content catalogue, P1) and must not boot Blender either.
if [[ "${1:-}" == "catalog" ]]; then
  shift
  exec "${UWP_PYTHON:-python3}" "$HERE/underworld_pipeline/catalog.py" "$@"
fi
# build-fx generates Godot particle scenes (P6, T-FX-01): runs in Godot, not Blender.
if [[ "${1:-}" == "build-fx" ]]; then
  exec "${GODOT:-/workspace/tools/godot}" --headless --path "$HERE/../GodotProject" --script res://Scripts/tools/build_fx.gd
fi
# review-sheet is plain Python/Pillow and must not boot Blender.
if [[ "${1:-}" == "review-sheet" ]]; then
  shift
  # Needs Pillow. Prefer a python that has it: $UWP_PYTHON, system python3, then the venv of a
  # bpy-wheel blender shim (Tools/sandbox/bootstrap_cloud.sh) - CI runners have no system Pillow.
  for PYC in "${UWP_PYTHON:-}" python3 "$(head -1 "$(readlink -f "${BLENDER:-/workspace/tools/blender/blender}")" 2>/dev/null | sed -n 's/^#!//p' | awk '{print $1}')"; do
    [[ -n "$PYC" ]] && "$PYC" -c "import PIL" 2>/dev/null && exec "$PYC" "$HERE/underworld_pipeline/review_sheet.py" "$@"
  done
  echo "uwp review-sheet: no python with Pillow found (set UWP_PYTHON)" >&2
  exit 4
fi
BLENDER="${BLENDER:-/workspace/tools/blender/blender}"
exec "$BLENDER" -b --factory-startup --python-exit-code 5 \
  --python "$HERE/underworld_pipeline/cli.py" -- "$@"
